$C = "../../Common.ui";

$C.@PageOverlay {}

$C.@Container {
    Anchor: (Width: 560, Height: 300);

    #Title {
        Group {
            $C.@Title {
               @Text = %customUI.textSign.title;
            }
        }
    }

     #Content {
            LayoutMode: Top;

            $C.@TextField #TXTSSignInput {
                @Anchor = (Left: 4, Bottom: 4);

                PlaceholderText: %customUI.textSign.placeholder;
                AutoFocus: true;
            }

            // Sign colour: Default uses the sign type's own ink, and each swatch is one of the 16 Minecraft colours
            Group #TXTSColourRow {
              LayoutMode: Left;
              Anchor: (Top: 10, Left: 4, Height: 22);

              Button #TXTSColourDefault {
                Anchor: (Width: 64, Height: 22);
                Style: (Default: (Background: #000000(0.3)), Hovered: (Background: #000000(0.5)));

                Label {
                  Text: %customUI.textSign.colourDefault;
                  Style: (Alignment: Center, VerticalAlignment: Center, FontSize: 13);
                }
              }

              Button #TXTSColourBlack {
                Anchor: (Width: 22, Height: 22, Left: 4);
                Style: (Default: (Background: #000000), Hovered: (Background: #000000(0.7)));
              }

              Button #TXTSColourDarkBlue {
                Anchor: (Width: 22, Height: 22, Left: 4);
                Style: (Default: (Background: #0000aa), Hovered: (Background: #0000aa(0.7)));
              }

              Button #TXTSColourDarkGreen {
                Anchor: (Width: 22, Height: 22, Left: 4);
                Style: (Default: (Background: #00aa00), Hovered: (Background: #00aa00(0.7)));
              }

              Button #TXTSColourDarkAqua {
                Anchor: (Width: 22, Height: 22, Left: 4);
                Style: (Default: (Background: #00aaaa), Hovered: (Background: #00aaaa(0.7)));
              }

              Button #TXTSColourDarkRed {
                Anchor: (Width: 22, Height: 22, Left: 4);
                Style: (Default: (Background: #aa0000), Hovered: (Background: #aa0000(0.7)));
              }

              Button #TXTSColourDarkPurple {
                Anchor: (Width: 22, Height: 22, Left: 4);
                Style: (Default: (Background: #aa00aa), Hovered: (Background: #aa00aa(0.7)));
              }

              Button #TXTSColourGold {
                Anchor: (Width: 22, Height: 22, Left: 4);
                Style: (Default: (Background: #ffaa00), Hovered: (Background: #ffaa00(0.7)));
              }

              Button #TXTSColourGrey {
                Anchor: (Width: 22, Height: 22, Left: 4);
                Style: (Default: (Background: #aaaaaa), Hovered: (Background: #aaaaaa(0.7)));
              }

              Button #TXTSColourDarkGrey {
                Anchor: (Width: 22, Height: 22, Left: 4);
                Style: (Default: (Background: #555555), Hovered: (Background: #555555(0.7)));
              }

              Button #TXTSColourBlue {
                Anchor: (Width: 22, Height: 22, Left: 4);
                Style: (Default: (Background: #5555ff), Hovered: (Background: #5555ff(0.7)));
              }

              Button #TXTSColourGreen {
                Anchor: (Width: 22, Height: 22, Left: 4);
                Style: (Default: (Background: #55ff55), Hovered: (Background: #55ff55(0.7)));
              }

              Button #TXTSColourAqua {
                Anchor: (Width: 22, Height: 22, Left: 4);
                Style: (Default: (Background: #55ffff), Hovered: (Background: #55ffff(0.7)));
              }

              Button #TXTSColourRed {
                Anchor: (Width: 22, Height: 22, Left: 4);
                Style: (Default: (Background: #ff5555), Hovered: (Background: #ff5555(0.7)));
              }

              Button #TXTSColourLightPurple {
                Anchor: (Width: 22, Height: 22, Left: 4);
                Style: (Default: (Background: #ff55ff), Hovered: (Background: #ff55ff(0.7)));
              }

              Button #TXTSColourYellow {
                Anchor: (Width: 22, Height: 22, Left: 4);
                Style: (Default: (Background: #ffff55), Hovered: (Background: #ffff55(0.7)));
              }

              Button #TXTSColourWhite {
                Anchor: (Width: 22, Height: 22, Left: 4);
                Style: (Default: (Background: #ffffff), Hovered: (Background: #ffffff(0.7)));
              }
            }

            Label #TXTSColourName {
              Anchor: (Top: 6, Left: 4);
              Style: (FontSize: 14);
            }

            Label #TXTSColourCodes {
              Text: %customUI.textSign.colourCodes;
              Anchor: (Top: 2, Left: 4);
              Style: (FontSize: 12, TextColor: #878e9c);
            }

            Group #TXTSCheckboxGroup {
              LayoutMode: Left;
              Anchor: (Top: 10, Left: 4);

              $C.@CheckBox #TXTSCheckBox {
                Value: false;
              }

              Label {
                Text: %customUI.textSign.lock;
                Anchor: (Left: 4);
              }
            }

            Group #TXTSButtonGroup {
              LayoutMode: Center;
              Anchor: (Top: 12, Height: 44);

              $C.@TextButton #TXTSSaveButton {
                Text: %customUI.textSign.save;
              }
            }
     }
}

$C.@BackButton {}
